}

.chat-loading-dot--2 {
  animation-delay: 0.15s;
}

.chat-loading-dot--3 {
  animation-delay: 0.3s;
}

@keyframes chatDotPulse {
  0%,
  80%,
  100% {
    opacity: 0.25;
    transform: scale(0.9);
  }

  40% {
    opacity: 1;
    transform: scale(1.08);
  }
}

