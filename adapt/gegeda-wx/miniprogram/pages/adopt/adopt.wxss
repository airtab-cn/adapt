.page {
  position: relative;
  height: 100vh;
  box-sizing: border-box;
  background-color: #f2f3f1;
}

.main-scroll {
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.adopt-swiper {
  width: 100%;
  height: 1120rpx;
  margin-bottom: -40rpx;
}

.adopt-slide {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.adopt-swiper-foot {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  margin: 28rpx 0 0;
  padding: 0 8rpx 4rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.adopt-swiper-dots {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.adopt-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: #d1d5db;
  border: none;
  transition: background 0.2s ease;
}

.adopt-dot--on {
  width: 28rpx;
  border-radius: 999rpx;
  background-color: #aed581;
  border-color: #c5e1a5;
  box-shadow: none;
}

.adopt-swiper-hint {
  font-size: 22rpx;
  color: #6b7280;
  letter-spacing: 0;
}

.hero {
  position: relative;
  margin: 20rpx 28rpx 0;
  padding: 32rpx 28rpx 28rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background-color: #ffffff;
  border: 1rpx solid #e8e9e7;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.hero-glow--a {
  width: 240rpx;
  height: 240rpx;
  right: -100rpx;
  top: -120rpx;
  background: radial-gradient(circle, rgba(76, 175, 80, 0.09) 0%, transparent 72%);
}

.hero-glow--b {
  width: 180rpx;
  height: 180rpx;
  left: -70rpx;
  bottom: -80rpx;
  background: radial-gradient(circle, rgba(76, 175, 80, 0.06) 0%, transparent 70%);
}

.hero-inner {
  position: relative;
  z-index: 1;
}

.hero-tool-stack {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  margin-top: -6rpx;
}

.hero-share-btn {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid #d9ead1;
  box-shadow: 0 8rpx 20rpx rgba(73, 103, 61, 0.08);
}

.hero-share-btn-hover {
  opacity: 0.86;
}

.hero-share-img {
  width: 32rpx;
  height: 32rpx;
  display: block;
}

.hero-badge {
  align-self: flex-start;
  display: inline-flex;
  padding: 6rpx 0 10rpx;
  margin-bottom: 20rpx;
  border-bottom: 3rpx solid #aed581;
}

.hero-badge-txt {
  font-size: 22rpx;
  font-weight: 600;
  color: #374151;
  letter-spacing: 2rpx;
}

.hero-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 28rpx;
}

.hero-avatar-wrap {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  flex-shrink: 0;
  padding: 8rpx;
  box-sizing: border-box;
  border-radius: 50%;
  overflow: hidden;
  background-color: #e8f5e9;
}

.hero-avatar {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background-color: #e8f5e9;
}

.hero-avatar-ring {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  border-radius: 50%;
  border: 3rpx solid #ffffff;
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.06);
  pointer-events: none;
}

.hero-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hero-name-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
}

.hero-name {
  flex: 1;
  min-width: 0;
  font-size: 40rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.25;
  letter-spacing: -0.5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-monitor {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  box-sizing: border-box;
  border: 1rpx solid #dcedc8;
  background: rgba(255, 255, 255, 0.88);
}

.hero-monitor--active {
  border-color: #c5e1a5;
  box-shadow: none;
}

.hero-monitor--disabled {
  opacity: 0.42;
  border-color: rgba(0, 0, 0, 0.08);
  background: rgba(0, 0, 0, 0.04);
}

.hero-monitor-hover {
  opacity: 0.88;
}

.hero-monitor--disabled.hero-monitor-hover {
  opacity: 0.5;
}

.hero-monitor-icon {
  width: 34rpx;
  height: 34rpx;
  display: block;
}

.hero-ring {
  font-size: 24rpx;
  font-weight: 500;
  color: #6b7280;
  letter-spacing: 0;
}

.hero-mood {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 6rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background-color: #f9faf8;
  border-left: 4rpx solid #aed581;
}

.hero-mood-txt {
  flex: 1;
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.55;
  font-weight: 400;
}

.section {
  margin: 24rpx 28rpx 0;
  padding: 26rpx 24rpx 28rpx;
  border-radius: 20rpx;
  background-color: #ffffff;
  border: 1rpx solid #e8e9e7;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.035);
  box-sizing: border-box;
}

.section.adopt-card {
  background-color: #ffffff;
  border: 1rpx solid #e8e9e7;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.035);
}

.section.adopt-card .timeline-label {
  color: #9ca3af;
  font-weight: 500;
}

.section.adopt-card .timeline-date {
  color: #1f2937;
  font-weight: 600;
}

.section.adopt-card .timeline-bar-bg {
  background-color: #eef0ee;
}

.section.adopt-card .section-pill--muted {
  background-color: #f3f4f6;
  border-color: #e5e7eb;
}

.section.adopt-card .section-pill--muted .section-pill-txt {
  color: #6b7280;
}

.section-head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 2rpx;
}

.section-head--rule {
  margin-bottom: 22rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #f0f0ee;
}

.section-head-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.25;
  letter-spacing: -0.5rpx;
}

.section-kicker {
  font-size: 24rpx;
  font-weight: 400;
  color: #9ca3af;
  line-height: 1.45;
}

.section-en {
  font-size: 20rpx;
  font-weight: 600;
  color: #9ca3af;
  letter-spacing: 3rpx;
}

.section-pill {
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  background-color: #ffffff;
  border: 1rpx solid #8bc34a;
  box-sizing: border-box;
}

.section-pill-txt {
  font-size: 22rpx;
  font-weight: 600;
  color: #5f8f2f;
}

.section-pill--muted {
  background-color: #f3f4f6;
  border-color: #e5e7eb;
}

.section-pill--muted .section-pill-txt {
  color: #6b7280;
}

.section-more {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 4rpx 8rpx 12rpx;
  margin-top: 2rpx;
}

.section-more-hover {
  opacity: 0.75;
}

.section-more-txt {
  font-size: 26rpx;
  font-weight: 600;
  color: #ff6d00;
}

.section-more-arrow {
  width: 10rpx;
  height: 10rpx;
  border-right: 3rpx solid #ff6d00;
  border-bottom: 3rpx solid #ff6d00;
  transform: rotate(-45deg);
}

.timeline {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.timeline-node {
  flex-shrink: 0;
  width: 168rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.timeline-node--end {
  align-items: flex-end;
  text-align: right;
}

.timeline-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #8d6e63;
  letter-spacing: 1rpx;
}

.timeline-date {
  font-size: 24rpx;
  font-weight: 600;
  color: #3e2723;
  line-height: 1.35;
}

.timeline-bar-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 10rpx;
  padding-top: 8rpx;
}

.timeline-bar-bg {
  height: 16rpx;
  border-radius: 999rpx;
  background-color: #eceff1;
  overflow: hidden;
}

.timeline-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background-color: #aed581;
  box-shadow: none;
  min-width: 8rpx;
  transition: width 0.35s ease;
}

.timeline-pct {
  font-size: 20rpx;
  font-weight: 600;
  color: #6b7280;
  text-align: center;
}

.adopt-stats {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  padding: 20rpx 8rpx 12rpx;
  border-radius: 12rpx;
  background-color: #f9faf8;
  border: 1rpx solid #eef0ee;
}

.adopt-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 0;
  border-radius: 14rpx;
}

.adopt-stat-num {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1;
}

.adopt-stat-unit {
  font-size: 22rpx;
  font-weight: 500;
  color: #6b7280;
  margin-left: 2rpx;
}

.adopt-stat-label {
  font-size: 22rpx;
  color: #9ca3af;
  font-weight: 400;
}

.adopt-stat-divider {
  width: 1rpx;
  margin: 8rpx 0;
  background-color: #e5e7eb;
}

.adopt-stat--tap {
  background: transparent;
  border: none;
}

.adopt-stat-hover {
  opacity: 0.82;
}

.section.adopt-goods-section {
  margin: -8rpx 28rpx 0;
  position: relative;
  z-index: 1;
  padding-bottom: 28rpx;
  background-color: #ffffff;
  border: 1rpx solid #e8e9e7;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.035);
}

.adopt-goods-section .section-title {
  color: #111827;
}

.adopt-goods-section .section-kicker {
  color: #9ca3af;
}

.adopt-goods-tag-strip {
  width: 100%;
  white-space: nowrap;
  margin: 0 -4rpx 8rpx;
  box-sizing: border-box;
}

.adopt-goods-tag-inner {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 4rpx 20rpx;
}

.adopt-goods-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background-color: #ffffff;
  border: 1rpx solid #e5e7eb;
  flex-shrink: 0;
}

.adopt-goods-tag--on {
  background-color: #f4f9ef;
  border-color: #aed581;
}

.adopt-goods-tag-hover {
  opacity: 0.88;
}

.adopt-goods-tag-txt {
  font-size: 26rpx;
  font-weight: 500;
  color: #6b7280;
  line-height: 1.2;
}

.adopt-goods-tag--on .adopt-goods-tag-txt {
  color: #7cb342;
  font-weight: 600;
}

.adopt-goods-list {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding-top: 4rpx;
}

.adopt-plan-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0ee;
  box-sizing: border-box;
}

.adopt-plan-row:last-child {
  border-bottom: none;
  padding-bottom: 8rpx;
}

.adopt-plan-row-hover {
  opacity: 0.96;
}

.adopt-plan-img {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background-color: #f3f4f6;
  display: block;
}

.adopt-plan-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding-top: 4rpx;
  padding-bottom: 2rpx;
}

.adopt-plan-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.adopt-plan-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
  margin-top: 10rpx;
}

.adopt-plan-cycle {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.45;
  font-weight: 400;
}

.adopt-plan-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: auto;
  padding-top: 16rpx;
  min-width: 0;
}

.adopt-plan-price {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 800;
  color: #ff6d00;
  line-height: 1.2;
}

.adopt-plan-btn {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  min-height: 60rpx;
  border-radius: 10rpx;
  background-color: #edf5e2;
  border: 2rpx solid #9fc86a;
  box-sizing: border-box;
}

.adopt-plan-btn-hover {
  background-color: #e3efd3;
}

.adopt-plan-btn-txt {
  font-size: 26rpx;
  font-weight: 600;
  color: #5f8f2f;
}

.adopt-goods-empty {
  padding: 48rpx 24rpx 24rpx;
  text-align: center;
}

.adopt-goods-empty-txt {
  font-size: 28rpx;
  color: #9e9e9e;
}

.ai-teaser--slide {
  flex-shrink: 0;
}

.ai-teaser {
  margin: 24rpx 28rpx 0;
  padding: 26rpx 24rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 20rpx;
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #ffffff 0%, #f8fbf4 100%);
  border: 1rpx solid #e7eee1;
  box-shadow: 0 10rpx 28rpx rgba(65, 95, 59, 0.08);
  border-left: 6rpx solid #9fca6c;
  box-sizing: border-box;
}

.ai-teaser-hover {
  opacity: 0.94;
}

.ai-teaser--disabled {
  background: linear-gradient(135deg, #ffffff 0%, #f7f9f5 100%);
  border-left-color: #cfd8c7;
  box-shadow: 0 8rpx 22rpx rgba(65, 95, 59, 0.045);
}

.ai-teaser--disabled .ai-teaser-avatar {
  opacity: 0.72;
}

.ai-teaser--disabled .ai-teaser-title,
.ai-teaser--disabled .ai-teaser-sub {
  color: #7b8578;
}

.ai-teaser--disabled .ai-teaser-badge {
  background: #f3f5f1;
  border-color: #e2e8dc;
  color: #8a9584;
}

.ai-teaser--disabled .ai-teaser-btn {
  border-color: #d8e0d2;
  background: #fafbf9;
  box-shadow: none;
}

.ai-teaser--disabled .ai-teaser-btn-txt {
  color: #8a9584;
}

.ai-teaser-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.ai-teaser-glow--a {
  width: 180rpx;
  height: 180rpx;
  top: -80rpx;
  right: -60rpx;
  background: radial-gradient(circle, rgba(174, 213, 129, 0.24) 0%, transparent 72%);
}

.ai-teaser-glow--b {
  width: 140rpx;
  height: 140rpx;
  left: -40rpx;
  bottom: -56rpx;
  background: radial-gradient(circle, rgba(194, 230, 160, 0.18) 0%, transparent 72%);
}

.ai-teaser-icon-wrap {
  width: 92rpx;
  height: 92rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #edf7e8 0%, #ffffff 100%);
  border: 1rpx solid #deecd3;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

.ai-teaser-emoji {
  font-size: 32rpx;
  font-weight: 700;
  color: #5f8f2f;
  letter-spacing: 2rpx;
  line-height: 1;
}

.ai-teaser-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  display: block;
}

.ai-teaser-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  position: relative;
  z-index: 1;
}

.ai-teaser-head {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.ai-teaser-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.ai-teaser-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.ai-teaser-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.ai-teaser-badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #eef7e7;
  border: 1rpx solid #dbeacb;
  color: #658c36;
  font-size: 20rpx;
  line-height: 1.2;
}

.ai-teaser-badge--soft {
  background: #f7faf4;
  color: #7a8971;
}

.ai-teaser-sub {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
  font-weight: 400;
}

.ai-teaser-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
}

.ai-teaser-tip {
  font-size: 22rpx;
  color: #8b9787;
}

.ai-teaser-btn {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  min-width: 104rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 2rpx solid #9fc86a;
  box-shadow: 0 8rpx 18rpx rgba(159, 200, 106, 0.14);
}

.ai-teaser-btn-txt {
  font-size: 26rpx;
  font-weight: 600;
  color: #5f8f2f;
}

.scroll-pad {
  height: 24rpx;
}

.chat-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
}

.chat-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(33, 33, 33, 0.48);
}

.chat-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 70vh;
  max-height: 70vh;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.08);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.chat-panel-grab {
  width: 72rpx;
  height: 8rpx;
  margin: 14rpx auto 6rpx;
  border-radius: 4rpx;
  background: rgba(0, 0, 0, 0.12);
}

.chat-head {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 24rpx 20rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.chat-head-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.chat-head-avatar {
  display: block;
