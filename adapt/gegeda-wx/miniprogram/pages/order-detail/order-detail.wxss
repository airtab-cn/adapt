.page {
  min-height: 100vh;
  padding: 24rpx;
  background:
    radial-gradient(circle at top, rgba(255, 248, 236, 0.95), transparent 34%),
    linear-gradient(180deg, #f7f9f5 0%, #f2f5ef 42%, #eef3ea 100%);
  box-sizing: border-box;
}

.hero {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 30rpx;
  border-radius: 32rpx;
  color: #24311f;
  background: linear-gradient(135deg, #fdf4df, #fffaf1);
  box-shadow: 0 20rpx 40rpx rgba(204, 168, 108, 0.12);
}

.hero--unshipped {
  background: linear-gradient(135deg, #eef6ff, #f8fbff);
}

.hero--unreceived,
.hero--completed {
  background: linear-gradient(135deg, #eef8ec, #f9fcf7);
}

.hero--closed,
.hero--refunded {
  background: linear-gradient(135deg, #f4f5f6, #fbfbfc);
}

.hero--refunding {
  background: linear-gradient(135deg, #fff1ef, #fff9f8);
}

.hero--aftersale,
.hero--returning,
.hero--pending_refund {
  background: linear-gradient(135deg, #fff6ee, #fffaf6);
}

.hero--aftersale_done {
  background: linear-gradient(135deg, #f2f6f1, #fafcf9);
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-status {
  display: inline-flex;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.75);
  color: #6e7d67;
  font-size: 22rpx;
}

.hero-title {
  margin-top: 20rpx;
  display: block;
  color: #22301d;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-desc {
  margin-top: 14rpx;
  display: block;
  color: #6d7d68;
  font-size: 24rpx;
  line-height: 1.7;
}

.hero-side {
  width: 190rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}

.hero-amount-label {
  color: #83907d;
  font-size: 20rpx;
}

.hero-amount {
  margin-top: 12rpx;
  color: #e28b36;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
}

.card {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 40rpx rgba(75, 90, 66, 0.08);
}

.highlight-card {
  margin-top: 20rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fff7e8, #fffdf8);
  border: 2rpx solid rgba(235, 199, 123, 0.45);
  box-shadow: 0 18rpx 36rpx rgba(218, 182, 109, 0.08);
}

.highlight-title {
  display: block;
  color: #8d6726;
  font-size: 28rpx;
  font-weight: 700;
}

.highlight-desc {
  display: block;
  margin-top: 12rpx;
  color: #8d7750;
  font-size: 24rpx;
  line-height: 1.7;
}

.highlight-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.highlight-item {
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.75);
}

.highlight-label {
  display: block;
  color: #a28b64;
  font-size: 20rpx;
}

.highlight-value {
  display: block;
  margin-top: 8rpx;
  color: #5e4a2a;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.6;
}

.card-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: baseline;
}

.card-title {
  color: #22301d;
  font-size: 30rpx;
  font-weight: 700;
}

.card-tip,
.card-link {
  color: #7e8d78;
  font-size: 22rpx;
}

.card-link {
  color: #76a15f;
}

.trace-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #f8fbf6 0%, #f4f8f1 100%);
  border: 2rpx solid rgba(118, 161, 95, 0.12);
}

.trace-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.trace-title {
  color: #24311f;
  font-size: 28rpx;
  font-weight: 700;
}

.trace-tip {
  color: #8a9784;
  font-size: 22rpx;
  text-align: right;
}

.trace-status-row {
  margin-top: 18rpx;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: center;
}

.trace-status-tag {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(110, 166, 90, 0.12);
  color: #5c9650;
  font-size: 22rpx;
  font-weight: 600;
}

.trace-status-time {
  color: #7f8d79;
  font-size: 22rpx;
}

.trace-context {
  margin-top: 16rpx;
  display: block;
  color: #33422d;
  font-size: 26rpx;
  line-height: 1.8;
}

.trace-timeline {
  margin-top: 24rpx;
  padding-top: 8rpx;
}

.trace-node {
  position: relative;
  padding: 0 0 20rpx 34rpx;
}

.trace-node:last-child {
  padding-bottom: 0;
}

.trace-node-line {
  position: absolute;
  left: 10rpx;
  top: 24rpx;
  bottom: -10rpx;
  width: 2rpx;
  background: rgba(118, 161, 95, 0.22);
}

.trace-node:last-child .trace-node-line {
  display: none;
}

.trace-node-dot {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #76a15f;
  box-shadow: 0 0 0 8rpx rgba(118, 161, 95, 0.12);
}

.trace-node-main {
  padding: 4rpx 0 0;
}

.trace-node-time {
  display: block;
  color: #6b7a65;
  font-size: 22rpx;
}

.trace-node-text {
  margin-top: 8rpx;
  display: block;
  color: #33422d;
  font-size: 24rpx;
  line-height: 1.75;
}

.trace-empty {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.88);
}

.trace-empty-text {
  color: #7f8d79;
  font-size: 24rpx;
  line-height: 1.8;
}

.progress-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.progress-item {
  position: relative;
  padding: 22rpx 24rpx 22rpx 72rpx;
  border-radius: 24rpx;
  background: #f6f8f4;
}

.progress-item--on {
  background: linear-gradient(135deg, #edf7e8, #f8fbf5);
}

.progress-dot {
  position: absolute;
  left: 28rpx;
  top: 30rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #b4c1ae;
}

.progress-item--on .progress-dot {
  background: #6ea65a;
  box-shadow: 0 0 0 10rpx rgba(110, 166, 90, 0.12);
}

.progress-label {
  display: block;
  color: #24311f;
  font-size: 28rpx;
  font-weight: 600;
}

.progress-time {
  margin-top: 10rpx;
  display: block;
  color: #82907d;
  font-size: 22rpx;
}

.product-body {
  margin-top: 24rpx;
  display: flex;
  gap: 22rpx;
}

.product-body + .product-body {
  padding-top: 20rpx;
  border-top: 1rpx solid #edf2e7;
}

.product-cover {
  width: 168rpx;
  height: 168rpx;
  border-radius: 24rpx;
  background: #f2f4ef;
  flex-shrink: 0;
}

.product-main {
  flex: 1;
  min-width: 0;
}

.product-title {
  color: #22301d;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.5;
}

.product-spec {
  margin-top: 12rpx;
  display: block;
  color: #7d8a78;
  font-size: 24rpx;
  line-height: 1.6;
}

.pill-row {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.soft-pill {
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f1f6ed;
  color: #607758;
  font-size: 22rpx;
  line-height: 48rpx;
}

.amount-box {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: #f8faf6;
}

.amount-row,
.stack-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: flex-start;
}

.amount-row + .amount-row,
.stack-row + .stack-row {
  margin-top: 16rpx;
}

.amount-row text,
.stack-row text {
  color: #788774;
  font-size: 24rpx;
  line-height: 1.6;
}

.amount-row--strong text:last-child {
  color: #e28b36;
  font-weight: 700;
}

.amount-discount {
  color: #79a261 !important;
  font-weight: 700;
}

.info-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.info-box {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f7f9f5;
}

.info-box--wide {
  grid-column: 1 / -1;
}

.info-label {
  color: #84917f;
  font-size: 20rpx;
}

.info-value {
  margin-top: 10rpx;
  display: block;
  color: #23301e;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.6;
}

.info-sub {
  margin-top: 8rpx;
  display: block;
  color: #8b9687;
  font-size: 22rpx;
  line-height: 1.6;
}

.stack-list {
  margin-top: 22rpx;
}

.invoice-card {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f7faf4, #fdfefd);
}

.invoice-head {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.invoice-title {
  color: #23301e;
  font-size: 28rpx;
  font-weight: 700;
}

.invoice-tag {
  color: #79a261;
  font-size: 22rpx;
  line-height: 1.6;
}

.invoice-list {
  margin-top: 18rpx;
}

.review-detail-head {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.review-stars {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.review-star {
  font-size: 30rpx;
  color: #f7b84b;
}

.review-time {
  color: #8a9684;
  font-size: 22rpx;
}

.review-detail-content {
  margin-top: 16rpx;
  display: block;
  color: #31402d;
  font-size: 25rpx;
  line-height: 1.8;
}

.review-image-grid,
.review-upload-grid {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.review-image,
.review-upload-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 18rpx;
  background: #eef3ea;
}

.review-upload-card {
  position: relative;
}

.review-upload-remove {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(27, 31, 35, 0.55);
  color: #fff;
  font-size: 20rpx;
}

.review-score-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 18rpx;
}

.review-score-star-wrap {
  position: relative;
  width: 48rpx;
  height: 48rpx;
}

.review-score-star-base,
.review-score-star-fill {
  position: absolute;
  left: 0;
  top: 0;
  font-size: 48rpx;
  line-height: 1;
}

.review-score-star-base {
  color: #d6ddd0;
}

.review-score-star-fill {
  color: #f7b84b;
  overflow: hidden;
  white-space: nowrap;
}

.review-score-star-fill--none {
  width: 0;
}

.review-score-star-fill--half {
  width: 24rpx;
}

.review-score-star-fill--full {
  width: 48rpx;
}

.review-score-hotspot {
  position: absolute;
  top: 0;
  width: 24rpx;
  height: 48rpx;
}

.review-score-hotspot--left {
  left: 0;
}

.review-score-hotspot--right {
  right: 0;
}

.review-score-value {
  margin-left: 10rpx;
  color: #6c8f57;
  font-size: 24rpx;
  font-weight: 600;
}

.review-upload-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 22rpx;
  border: 2rpx dashed #b5d59f;
  background: linear-gradient(180deg, #f8fcf4, #eff8e7);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.45);
}

.review-upload-plus {
  color: #78ad5c;
  font-size: 48rpx;
  line-height: 1;
  font-weight: 400;
}

.review-upload-text {
  color: #6f9d58;
  font-size: 22rpx;
  line-height: 1.4;
}

.mono {
  font-family: Consolas, "Courier New", monospace;
  word-break: break-all;
}

.loading-wrap {
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-text {
  color: #7f8d79;
  font-size: 28rpx;
}

.safe-space {
  height: 150rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -10rpx 30rpx rgba(71, 88, 62, 0.08);
  box-sizing: border-box;
}

.action-price {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.action-price-label {
  color: #8a9785;
  font-size: 22rpx;
}

.action-price-sub {
  margin-top: 8rpx;
  color: #8a9785;
  font-size: 22rpx;
  line-height: 1.5;
}

.action-price-value {
  margin-top: 6rpx;
  color: #e28b36;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.pay-btn {
  width: 220rpx;
  height: 72rpx;
  margin: 0;
  margin-left: auto;
  padding: 0;
  border-radius: 999rpx;
  border: 2rpx solid rgba(133, 182, 109, 0.34);
  background: linear-gradient(135deg, #eaf7df, #f6fbef);
  color: #5f8b49;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 24rpx rgba(122, 167, 97, 0.14);
  flex-shrink: 0;
}

.cancel-action {
  margin: 0 16rpx 0 0;
  color: #9aa59a;
  font-size: 24rpx;
  line-height: 1.4;
  flex-shrink: 0;
}

.action-bar--triple {
  justify-content: space-between;
  gap: 12rpx;
}

.ghost-btn {
  min-width: 0;
  flex: 1;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  border: 2rpx solid #d8e0d2;
  background: rgba(255, 255, 255, 0.96);
  color: #73816d;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.pay-btn--compact {
  min-width: 0;
  width: auto;
  flex: 1;
  margin-left: 0;
}

.pay-btn--return {
  background: linear-gradient(135deg, #eaf7df, #f6fbef);
  color: #5f8b49;
  border: 2rpx solid rgba(133, 182, 109, 0.34);
  box-shadow: 0 12rpx 24rpx rgba(122, 167, 97, 0.14);
}

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 24, 18, 0.38);
  z-index: 20;
}

.sheet-card {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 24rpx 48rpx rgba(45, 60, 39, 0.16);
  z-index: 21;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.sheet-title {
  color: #24311f;
  font-size: 30rpx;
  font-weight: 700;
}

.sheet-close {
  color: #8a9785;
  font-size: 24rpx;
}

.sheet-options {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.sheet-option {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f7f9f5;
  border: 2rpx solid transparent;
}

.sheet-option--active {
  border-color: rgba(118, 161, 95, 0.28);
  background: linear-gradient(180deg, #fbfdf9 0%, #f3f8ef 100%);
}

.sheet-option-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.sheet-option-title {
  color: #24311f;
  font-size: 26rpx;
  font-weight: 700;
}

.sheet-option-desc {
  color: #879380;
  font-size: 22rpx;
  line-height: 1.6;
}

.sheet-field {
  margin-top: 22rpx;
}

.sheet-label {
  display: block;
  color: #6f7d69;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.sheet-evidence-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.sheet-evidence-tip {
  color: #94a18f;
  font-size: 22rpx;
}

.sheet-evidence-box {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: #f4f8f1;
  border: 2rpx solid rgba(123, 170, 108, 0.18);
}

.sheet-evidence-image {
  width: 100%;
  height: 100%;
}

.sheet-evidence-remove {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(31, 41, 24, 0.56);
  color: #fff;
  font-size: 20rpx;
}

.sheet-textarea,
.sheet-input {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 24rpx;
  border-radius: 20rpx;
  background: #f7f9f5;
  color: #24311f;
  font-size: 26rpx;
  border: 2rpx solid rgba(130, 164, 110, 0.12);
}

.sheet-textarea {
  min-height: 168rpx;
}

.sheet-input {
  min-height: 88rpx;
  line-height: 40rpx;
}

.sheet-upload-btn {
  margin-top: 16rpx;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid #b7d7aa;
  background: linear-gradient(135deg, #eef8e7, #f7fcf3);
  color: #5d8a49;
  font-size: 24rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.sheet-submit {
  margin-top: 28rpx;
  height: 80rpx;
  padding: 0;
  border-radius: 999rpx;
  border: none;
  background: linear-gradient(135deg, #f1b050, #e78e33);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.sheet-submit--return {
  background: linear-gradient(135deg, #eaf7df, #f6fbef);
  color: #5f8b49;
  border: 2rpx solid rgba(133, 182, 109, 0.34);
  box-shadow: 0 14rpx 26rpx rgba(122, 167, 97, 0.15);
}

.sheet-counter {
  margin-top: 12rpx;
  display: block;
  text-align: right;
  color: #8b9885;
  font-size: 22rpx;
}

.sheet-copy-link {
  color: #68a14d;
  font-size: 22rpx;
  font-weight: 600;
}

.sheet-receiver-card {
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fbfdf8, #f3f8ee);
  border: 2rpx solid rgba(130, 164, 110, 0.14);
}

.sheet-receiver-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.sheet-receiver-row + .sheet-receiver-row {
  margin-top: 16rpx;
}

.sheet-receiver-row--top {
