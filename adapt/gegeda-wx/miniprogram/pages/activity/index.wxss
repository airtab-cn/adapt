.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 48rpx;
  box-sizing: border-box;
  background: #f3f5f7;
}

.hero {
  padding: 36rpx 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(17, 24, 39, 0.06);
  box-shadow: 0 8rpx 22rpx rgba(17, 24, 39, 0.05);
}

.hero-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.2;
}

.hero-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
}

.section {
  margin-top: 22rpx;
  padding: 24rpx 22rpx 16rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(17, 24, 39, 0.06);
  box-shadow: 0 8rpx 22rpx rgba(17, 24, 39, 0.05);
  box-sizing: border-box;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.section-sub {
  font-size: 22rpx;
  color: #9ca3af;
}

.act-card {
  margin-bottom: 18rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(17, 24, 39, 0.06);
  background: #f9fafb;
}

.act-card:last-child {
  margin-bottom: 8rpx;
}

.act-card-hover {
  opacity: 0.84;
}

.act-cover {
  width: 100%;
  height: 260rpx;
  display: block;
  background: #e5e7eb;
}

.act-body {
  padding: 20rpx 18rpx 18rpx;
}

.act-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.act-tag {
  font-size: 20rpx;
  color: #4b5563;
  background: #eef2f7;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.act-status {
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.act-status--on {
  color: #166534;
  background: #dcfce7;
}

.act-status--wait {
  color: #92400e;
  background: #fef3c7;
}

.act-title {
  display: block;
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.act-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
}

.act-foot {
  margin-top: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.act-date {
  font-size: 22rpx;
  color: #6b7280;
}

.act-action {
  font-size: 22rpx;
  color: #2563eb;
}

.section--rules {
  padding-bottom: 20rpx;
}

.rule-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.rule-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #9ca3af;
  margin-top: 12rpx;
  flex-shrink: 0;
}

.rule-text {
  flex: 1;
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.6;
}
