.page {
  min-height: 100vh;
  padding: 20rpx 24rpx 110rpx;
  box-sizing: border-box;
  background: #f2f3f1;
}

.card {
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e8e9e7;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.field-row {
  min-height: 88rpx;
  border-bottom: 1rpx solid #f0f0ee;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.field-row--textarea {
  align-items: flex-start;
  padding-top: 20rpx;
  padding-bottom: 12rpx;
}

.field-row--switch {
  border-bottom: none;
}

.field-label {
  width: 130rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #4b5563;
}

.field-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 25rpx;
  color: #111827;
}

.field-picker {
  flex: 1;
  min-width: 0;
}

.field-picker-inner {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-picker-text {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: #111827;
}

.field-picker-text--ph {
  color: #9ca3af;
}

.field-picker-arrow {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.field-textarea {
  flex: 1;
  min-width: 0;
  height: 140rpx;
  font-size: 24rpx;
  color: #111827;
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(53, 60, 74, 0.08);
}

.save-btn {
  height: 74rpx;
  line-height: 74rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
  background: #22c55e;
}

.save-btn-hover {
  opacity: 0.9;
}
