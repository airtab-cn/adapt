.page {
  min-height: 100vh;
  padding: 20rpx 24rpx 30rpx;
  box-sizing: border-box;
  background: #f2f3f1;
}

.hero {
  position: relative;
  padding: 34rpx 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e8e9e7;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.hero-glow--a {
  width: 220rpx;
  height: 220rpx;
  right: -84rpx;
  top: -108rpx;
  background: radial-gradient(circle, rgba(76, 175, 80, 0.12) 0%, transparent 72%);
}

.hero-glow--b {
  width: 170rpx;
  height: 170rpx;
  left: -68rpx;
  bottom: -82rpx;
  background: radial-gradient(circle, rgba(76, 175, 80, 0.07) 0%, transparent 72%);
}

.hero-inner {
  position: relative;
  z-index: 1;
}

.hero-kicker {
  display: block;
  font-size: 20rpx;
  color: #9ca3af;
  letter-spacing: 3rpx;
  font-weight: 700;
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.2;
}

.hero-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.7;
}

.hero-badges {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.hero-badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #2e7d32;
  background: #edf8ee;
  border: 1rpx solid rgba(76, 175, 80, 0.28);
}

.section {
  margin-top: 20rpx;
  padding: 24rpx 22rpx 20rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e8e9e7;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.035);
  box-sizing: border-box;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-head--rule {
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0ee;
}

.section-head-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.section-kicker {
  font-size: 23rpx;
  color: #9ca3af;
  line-height: 1.45;
}

.event-card {
  position: relative;
  margin-bottom: 18rpx;
  border-radius: 18rpx;
  overflow: hidden;
  border: 1rpx solid #e8eee4;
  background: linear-gradient(165deg, #fdfefd 0%, #f8fbf7 100%);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.04);
}

.event-card:last-child {
  margin-bottom: 8rpx;
}

.event-card-hover {
  opacity: 0.92;
}

.event-cover {
  width: 100%;
  height: 286rpx;
  display: block;
  background: #e5e7eb;
}

.event-top-badge {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  z-index: 5;
  height: 42rpx;
  line-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #ff8a00 0%, #ff5e00 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 94, 0, 0.28);
}

.event-stamp {
  position: absolute;
  right: 14rpx;
  top: 14rpx;
  width: 102rpx;
  height: 102rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  border: 3rpx solid #90a4ae;
  color: #90a4ae;
  transform: rotate(-10deg);
  background: rgba(255, 255, 255, 0.92);
  box-shadow:
    inset 0 0 0 6rpx rgba(255, 255, 255, 0.9),
    0 6rpx 14rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}

.event-stamp--on {
  border-color: #2e7d32;
  color: #2e7d32;
  background: radial-gradient(circle at 30% 30%, rgba(232, 245, 233, 0.95), rgba(255, 255, 255, 0.92));
}

.event-stamp--done {
  border-color: #78909c;
  color: #607d8b;
  background: radial-gradient(circle at 30% 30%, rgba(236, 239, 241, 0.95), rgba(255, 255, 255, 0.92));
}

.event-stamp--wait {
  border-color: #b45309;
  color: #92400e;
  background: radial-gradient(circle at 30% 30%, rgba(254, 243, 199, 0.95), rgba(255, 255, 255, 0.92));
}

.event-body {
  padding: 22rpx 20rpx 20rpx;
}

.event-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.event-tag {
  font-size: 22rpx;
  color: #2e7d32;
  background: #edf8ee;
  border: 1rpx solid rgba(76, 175, 80, 0.22);
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.event-title {
  display: block;
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.35;
}

.event-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.65;
}

.event-foot {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.event-date {
  font-size: 23rpx;
  color: #8d98a8;
}

.event-line {
  flex: 1;
  height: 1rpx;
  background: #edf0ec;
  margin-right: 14rpx;
}

.event-action {
  font-size: 23rpx;
  color: #4caf50;
  font-weight: 600;
}

.section--rules {
  padding-bottom: 20rpx;
}

.rule-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.rule-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #4caf50;
  margin-top: 13rpx;
  flex-shrink: 0;
}

.rule-text {
  flex: 1;
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.7;
}

.message-empty {
  color: #9ca3af;
  font-size: 24rpx;
  padding: 6rpx 0 10rpx;
}

.message-item {
  border-top: 1rpx dashed #e5e7eb;
  padding: 14rpx 0;
}

.message-item:first-of-type {
  border-top: none;
  padding-top: 0;
}

.message-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.message-user {
  font-size: 24rpx;
  color: #111827;
  font-weight: 600;
}

.message-time {
  font-size: 20rpx;
  color: #9ca3af;
}

.message-activity {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.message-content {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #374151;
  line-height: 1.6;
}
