.page {
  min-height: 100vh;
  padding: 0 24rpx 40rpx;
  box-sizing: border-box;
  background: #f3f5f7;
}

.cover {
  width: 100%;
  height: 360rpx;
  margin-top: 20rpx;
  border-radius: 18rpx;
  background: #e5e7eb;
}

.panel {
  margin-top: 20rpx;
  padding: 24rpx 22rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid rgba(17, 24, 39, 0.06);
  box-shadow: 0 6rpx 18rpx rgba(17, 24, 39, 0.05);
}

.head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  flex: 1;
}

.tag {
  font-size: 20rpx;
  color: #4b5563;
  background: #eef2f7;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  white-space: nowrap;
  min-height: 42rpx;
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.status-text {
  display: block;
  line-height: 1.35;
}

.status--on {
  color: #166534;
  background: #dcfce7;
}

.status--done {
  color: #475569;
  background: #e2e8f0;
}

.status--book {
  color: #92400e;
  background: #fef3c7;
}

.title {
  display: block;
  margin-top: 14rpx;
  font-size: 34rpx;
  color: #111827;
  font-weight: 700;
  line-height: 1.35;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
}

.date {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.sec-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 14rpx;
}

.content {
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.7;
}

.highlight-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #9ca3af;
  margin-top: 12rpx;
  flex-shrink: 0;
}

.highlight-text {
  flex: 1;
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.6;
}

.comment-form {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: linear-gradient(180deg, #f4faef 0%, #edf7e4 100%);
  border: 1rpx solid rgba(76, 175, 80, 0.14);
}

.comment-top {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.comment-top-sub {
  font-size: 20rpx;
  color: #90a98b;
  letter-spacing: 2rpx;
}

.comment-input-wrap {
  flex: 1;
  width: auto;
  min-width: 0;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid rgba(76, 175, 80, 0.22);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.comment-textarea {
  width: 100%;
  min-height: 92rpx;
  padding: 14rpx 18rpx;
  font-size: 24rpx;
  color: #111827;
  border-radius: 12rpx;
  background: transparent;
  border: none;
  box-sizing: border-box;
}

.comment-input-ph {
  color: #9ca3af;
}

.comment-submit-btn {
  width: auto;
  min-width: 78rpx;
  height: 48rpx;
  line-height: 48rpx;
  margin: 0;
  padding: 0 16rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #5cb85c 0%, #43a047 100%);
  border: 1rpx solid rgba(47, 125, 50, 0.28);
  box-shadow: 0 6rpx 14rpx rgba(67, 160, 71, 0.22);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-align: center;
  flex-shrink: 0;
  align-self: flex-end;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.comment-submit-btn::after {
  border: none;
}

.comment-empty {
  font-size: 24rpx;
  color: #9ca3af;
  text-align: center;
  padding-top: 20rpx;
}

.comment-list {
  margin-top: 6rpx;
}

.comment-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 14rpx 0;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  border-radius: 50%;
  overflow: hidden;
  background: #f0f0f0;
}

.comment-avatar-img {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f0f0f0;
}

.comment-avatar-txt {
  font-size: 20rpx;
  font-weight: 700;
  color: #2e7d32;
  line-height: 1;
}

.comment-main {
  flex: 1;
  min-width: 0;
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  background: #f7fbf3;
  border: 1rpx solid rgba(76, 175, 80, 0.12);
}

.comment-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.comment-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2937;
}

.comment-time {
  font-size: 20rpx;
  color: #9ca3af;
}

.comment-content {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #334155;
  line-height: 1.55;
}

.comment-scroll {
  height: 540rpx;
  margin-top: 18rpx;
}

.comment-loading,
.comment-no-more {
  text-align: center;
  color: #9ca3af;
  font-size: 22rpx;
  padding: 16rpx 0 8rpx;
}

.panel--warn {
  background: #fffbeb;
  border-color: #fde68a;
}

.warn {
  font-size: 24rpx;
  color: #92400e;
}

