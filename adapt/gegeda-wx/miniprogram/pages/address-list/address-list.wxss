.page {
  min-height: 100vh;
  padding: 20rpx 24rpx 116rpx;
  box-sizing: border-box;
  background: #f2f3f1;
}

.hero {
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e8e9e7;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.hero-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.hero-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.list-wrap {
  margin-top: 14rpx;
}

.addr-card {
  margin-bottom: 12rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 1rpx solid #e8e9e7;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.04);
}

.addr-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.addr-user {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.addr-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
}

.addr-phone {
  font-size: 24rpx;
  color: #6b7280;
}

.addr-default {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid #d1d5db;
}

.addr-default--on {
  border-color: #22c55e;
  background: #ecfdf3;
}

.addr-default-txt {
  font-size: 20rpx;
  color: #6b7280;
}

.addr-default--on .addr-default-txt {
  color: #16a34a;
  font-weight: 700;
}

.addr-line {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #374151;
  line-height: 1.6;
}

.addr-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 0;
  padding-top: 12rpx;
  border-top: 1rpx solid #f1f3f5;
}

.addr-action-btn {
  min-width: 96rpx;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 500;
}

.addr-action-btn--danger {
  color: #ef4444;
}

.addr-action-divider {
  width: 1rpx;
  height: 26rpx;
  background: #e5e7eb;
}

.addr-action-btn-hover {
  opacity: 0.72;
}

.empty {
  margin-top: 14rpx;
  padding: 56rpx 18rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 1rpx solid #e8e9e7;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  color: #4b5563;
  font-weight: 600;
}

.empty-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(53, 60, 74, 0.08);
}

.add-btn {
  height: 74rpx;
  line-height: 74rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
  background: #22c55e;
}

.add-btn-hover {
  opacity: 0.9;
}
