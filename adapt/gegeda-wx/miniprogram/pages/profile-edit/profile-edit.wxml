<view class="page">
  <view class="hint">修改头像与昵称，保存后会在“我的”页面生效。</view>
  <view class="uid-card">
    <text class="uid-label">用户ID</text>
    <text class="uid-value">{{userUid}}</text>
  </view>
  <view class="card">
    <view class="cell cell--avatar">
      <text class="cell-label">头像</text>
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar-preview" src="{{avatar}}" mode="aspectFill" />
        <text class="avatar-tip">点击更换</text>
      </button>
    </view>

    <view class="cell">
      <text class="cell-label">昵称</text>
      <input
        class="cell-input"
        type="nickname"
        value="{{nickname}}"
        placeholder="请输入昵称"
        maxlength="16"
        bindinput="onNicknameInput"
      />
    </view>
  </view>

  <button class="save-btn" bindtap="onSave">保存</button>
</view>
