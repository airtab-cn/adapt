.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx 48rpx;
  background: #f5f6f8;
}

.hint {
  font-size: 26rpx;
  color: #8e8e93;
  line-height: 1.5;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.uid-card {
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  padding: 26rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.uid-label {
  font-size: 28rpx;
  color: #1f1f1f;
  font-weight: 500;
}

.uid-value {
  font-size: 28rpx;
  color: #4caf50;
  font-weight: 700;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 48rpx;
}

.cell {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 28rpx 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.cell:last-child {
  border-bottom: none;
}

.cell--avatar {
  align-items: center;
  justify-content: space-between;
}

.cell-label {
  font-size: 30rpx;
  color: #1f1f1f;
  font-weight: 500;
  width: 120rpx;
  flex-shrink: 0;
}

.avatar-btn {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.avatar-preview {
  display: block;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #eee;
  border: 3rpx solid rgba(76, 175, 80, 0.2);
  box-sizing: border-box;
}

.avatar-tip {
  font-size: 26rpx;
  color: #4caf50;
  font-weight: 500;
}

.cell-input {
  flex: 1;
  min-width: 0;
  height: 48rpx;
  font-size: 30rpx;
  color: #1f1f1f;
  text-align: right;
}

.save-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #43a047;
  background: #ffffff;
  border: 2rpx solid #43a047;
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.save-btn::after {
  border: none;
}
