.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f7faf5 0%, #ffffff 220rpx);
}

.hero {
  margin-bottom: 18rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff, #f3f9ee);
  border: 1rpx solid rgba(153, 188, 130, 0.18);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-title {
  display: block;
  color: #253120;
  font-size: 32rpx;
  font-weight: 700;
}

.hero-sub {
  display: block;
  margin-top: 10rpx;
  color: #81907b;
  font-size: 22rpx;
}

.hero-tag {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eef8e7;
  color: #70a252;
  font-size: 22rpx;
  font-weight: 600;
}

.review-card {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(150, 181, 129, 0.12);
  box-shadow: 0 14rpx 32rpx rgba(82, 105, 68, 0.06);
}

.review-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.review-user-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #edf3e7;
}

.avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7ea863;
  font-size: 24rpx;
  font-weight: 700;
}

.review-user-meta {
  flex: 1;
  min-width: 0;
}

.review-user {
  display: block;
  color: #273320;
  font-size: 26rpx;
  font-weight: 600;
}

.review-time {
  display: block;
  margin-top: 6rpx;
  color: #92a08c;
  font-size: 22rpx;
}

.review-score {
  flex-shrink: 0;
  color: #76a65a;
  font-size: 24rpx;
  font-weight: 700;
}

.review-content {
  display: block;
  margin-top: 18rpx;
  color: #34412d;
  font-size: 26rpx;
  line-height: 1.8;
  word-break: break-word;
}

.image-grid {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.review-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  background: #edf3e8;
}

.empty-wrap,
.loading-wrap,
.footer-tip {
  padding: 56rpx 24rpx;
  text-align: center;
}

.empty-title,
.loading-text,
.footer-text {
  display: block;
  color: #64725d;
  font-size: 26rpx;
}

.empty-sub {
  display: block;
  margin-top: 12rpx;
  color: #9aa595;
  font-size: 22rpx;
}
